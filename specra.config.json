{
  "$schema": "./node_modules/specra/config/specra.config.schema.json",
  "site": {
    "title": "Aqua Protocol",
    "description": "Aqua Protocol, an open protocol for verifiable data provenance and accountability. Developed in the open as a proposed standard, with public specification, documentation, and reference implementations.",
    "url": "https://aqua-protocol.org",
    "baseUrl": "/",
    "language": "en",
    "organizationName": "inblockio",
    "projectName": "aqua-docs",
    "activeVersion": "v4.0.0",
    "favicon": "/logo/aqua-logo.png",
    "logo": {
      "dark": "/logo/aqua-logo.png",
      "light": "/logo/aqua-logo.png"
    }
  },
  "theme": {
    "defaultMode": "system",
    "respectPrefersColorScheme": true
  },
  "navigation": {
    "showSidebar": true,
    "collapsibleSidebar": true,
    "showBreadcrumbs": true,
    "showTableOfContents": true,
    "tocPosition": "right",
    "tocMaxDepth": 3
  },
  "social": {
    "github": "https://github.com/inblockio",
    "twitter": "https://x.com/inblockio",
    "custom": [
      {
        "label": "inblock.io",
        "url": "https://inblock.io"
      }
    ]
  },
  "search": {
    "enabled": false,
    "placeholder": "Search documentation...",
    "provider": "meilisearch",
    "meilisearch": {
      "host": "http://localhost:7700",
      "apiKey": "aSampleMasterKey",
      "indexName": "docs"
    }
  },
  "analytics": {
    "googleAnalytics": "",
    "plausible": ""
  },
  "footer": {
    "copyright": "Copyright © 2026 inblock.io assets GmbH. All rights reserved.",
    "links": [
      {
        "title": "Documentation",
        "items": [
          {
            "label": "Getting Started",
            "href": "/docs/v3.0.2/introduction"
          },
          {
            "label": "Specification",
            "href": "/docs/v3.0.2/schema"
          }
        ]
      },
      {
        "title": "Community",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/inblockio"
          }
        ]
      }
    ]
  },
  "banner": {
    "enabled": false,
    "message": "🎉 Aqua protocol - Let us build privacy infra together!",
    "type": "error",
    "dismissible": true
  },
  "features": {
    "editUrl": "https://github.com/inblockio/aqua-docs/edit/main/docs",
    "showLastUpdated": true,
    "showReadingTime": true,
    "showAuthors": false,
    "showTags": true,
    "versioning": true
  },
  "deployment": {
    "target": "github-pages",
    "basePath": "",
    "customDomain": true
  }
}